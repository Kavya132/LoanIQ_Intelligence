# Environment configuration - DO NOT commit this file with actual keys
# Copy to .env and fill in your actual values

# LLM Configuration
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4-turbo
LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai

# Data Mode
DATA_MODE=demo

# Logging
LOG_LEVEL=INFO

# Development
DEBUG=false
VERBOSE=false
